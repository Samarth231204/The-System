# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your secrets never reach GitHub.

# MongoDB Atlas connection string (needed from Phase 2).
# Atlas > your cluster > Connect > Drivers. Replace <db_password> with your
# database user's password, and add the database name after the slash, e.g.
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/the-system?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login sessions (needed from Phase 2).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=
